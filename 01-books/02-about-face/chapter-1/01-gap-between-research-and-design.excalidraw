    {
      "id": "nVDa1xGCQZYQi1a436adi",
      "type": "text",
      "x": 455.1248125426893,
      "y": 150.3549245711542,
      "width": 557.5035400390625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
